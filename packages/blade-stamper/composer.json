{
    "name": "portbay/blade-stamper",
    "description": "Dev-time source-location stamping for Laravel Blade templates — data-pb-loc for PortBay's visual editor.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "portbay",
        "laravel",
        "blade",
        "source-location",
        "visual-editor",
        "devtools"
    ],
    "authors": [
        {
            "name": "Tribal House LLC"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/view": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Portbay\\BladeStamper\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Portbay\\BladeStamper\\PortbayLocServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "php test/StampTest.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
